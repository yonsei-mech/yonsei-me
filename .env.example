# Auth.js v5 + GitHub OAuth — 관리자 콘솔(/contentmanagement) 인증용.
# 실제 값은 .env.local(로컬) / 서버 환경파일(배포: /etc/yonsei_me/env)에 넣는다.
# 이 파일은 키 목록만.

# Auth.js 세션 암호화 키. 생성: `npx auth secret` 또는 `openssl rand -base64 32`
AUTH_SECRET=

# GitHub OAuth App 의 Client ID / Client Secret.
# GitHub → Settings → Developer settings → OAuth Apps 에서 발급.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# 접근을 허용할 GitHub 계정명(login) 쉼표 구분 목록.
# 저장소 소유자(halfjinhyeon)는 코드에서 항상 허용되므로 여기 없어도 된다.
# 예: ALLOWED_GITHUB_LOGINS=alice,bob
ALLOWED_GITHUB_LOGINS=

# (선택, 개발 전용) 로컬 dev 서버에서 GitHub 로그인 없이 /contentmanagement 를
# 열어볼 수 있게 하는 우회 토큰. 프로덕션 빌드(NODE_ENV=production)에서는 무시된다.
# 실제로 GitHub API 커밋까지 테스트하려면 여기에 GitHub PAT(repo scope)을 넣는다.
# 비워두면 콘솔 UI는 뜨지만 목록 조회/저장은 401로 실패한다(레이아웃 확인용으로는 충분).
DEV_GITHUB_TOKEN=

# (선택) DeepL 번역 API 키 — 관리자 콘솔 "번역 채우기" 버튼용(서버에서만 사용).
# https://www.deepl.com/pro-api 무료 플랜 가입 후 발급. 무료 키는 ":fx" 로 끝난다.
# 비워두면 번역 버튼이 "번역 미설정" 안내를 표시하고 나머지 기능엔 영향 없다.
DEEPL_API_KEY=

# ── 백엔드 전환(2026-07) — 게시판 DB + 첨부 스토리지 ──────────────────

# Supabase(Postgres) — 게시판 posts/attachments. Settings → API 에서 확인.
# service_role 키는 RLS 를 우회하는 서버 전용 키 — 절대 클라이언트에 노출 금지.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 목록 캐시 무효화(POST /api/revalidate) 의 공유 비밀값. 서버가 요청 헤더
# `x-revalidate-secret` 을 이 값과 비교한다. 비워두면 라우트가 503 으로 아무것도 받지 않는다.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cafe24(/etc/yonsei_me/env) · 로컬 .env.local 에 **같은 값**을 넣는다.
REVALIDATE_SECRET=

# (로컬 스크립트 전용 — 서버에는 넣지 않는다) 무효화할 호스트 origin 쉼표 구분 목록.
# tools/automation/revalidate.mjs 와 board-sync.mjs 가 여기 적힌 호스트를 차례로 두드린다.
# 예: REVALIDATE_URLS=https://me.yonsei.ac.kr,https://aquaelle06.mycafe24.com
REVALIDATE_URLS=

# Cloudflare R2 — 첨부 실체 저장(무료 10GB, 전송 무료). R2 → Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 버킷 Settings → Public access 의 r2.dev 주소(끝 슬래시 없이) 또는 커스텀 도메인.
R2_PUBLIC_BASE_URL=
