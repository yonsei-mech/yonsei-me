# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/.next-dev/
/out/

# dev-only tooling assets (large, locally regenerable)
/tools/traineddata/
# dev 전용 첨부 업로드 폴더 — 프로덕션은 Vercel Blob 에 저장(로컬 검증용 대체 경로)
/public/uploads/
# 연세체 TTF — 배포 라이선스 불명확, 로고 워드마크는 tools/generate-wordmark.mjs 로
# 빌드타임에 SVG 패스(src/components/logo-wordmark.ts)로 미리 변환해두므로 폰트 자체는 불필요.
# 폴더는 통째로 무시하되, 동적 서브셋 생성기와 그 원본 폰트(tools/fonts/src/)는 되살린다 —
# public/webfonts/ 의 조각을 재생성하려면 이 셋이 저장소에 있어야 한다.
/tools/fonts/*
!/tools/fonts/README.md
!/tools/fonts/korean-slices.json
!/tools/fonts/split-dynamic-subset.py
!/tools/fonts/src/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env
.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel
/public/fonts/

# 자동화 실행 상태 — 학기 갱신 오케스트레이터가 어디까지 했는지 적어 두는 로컬 파일
# (tools/automation/update-semester.mjs · 백테스트 덤프도 여기 떨어진다)
/tools/automation/.state/

# 게시판 이전 중간 산출물 — 원본 사이트 크롤 스냅샷(수 MB, 언제든 재생성 가능)
/tools/boards-raw/
/tools/link-report.json
/tools/link-body-cache.json
/tools/pre-import-snapshot.json
# 자산 미러링·링크 재작성의 롤백 스냅숏(영향 행의 이전 값). 컷오버 전 board-sync 가 매일
# 하나씩 남기므로 커밋 대상이 아니다 — 로컬 보관 전용이다.
/tools/legacy-mirror-snapshot-*.json
/tools/legacy-links-snapshot-*.json

# 입학처 변경 감지 워크플로가 스냅샷 브랜치(bot/admission-watch)를 체크아웃하는 자리 — 로컬 시험용
/.admission-snapshots/
# admission-watch 의 `--patch` 사본. 러너에서는 PR 커밋으로 바뀌어 사라지지만, 로컬 시험 실행에서는
# 진짜 콘텐츠 바로 옆에 남는다 — 실수로 커밋되지 않게 막는다.
/content/admission-guide.json.new
